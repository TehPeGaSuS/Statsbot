{
  // Cloudflare Workers (static assets): serves docs/ as the documentation site.
  // Deploy command in the Cloudflare dashboard:  npx wrangler deploy
  // The Worker in the dashboard must be called exactly "statsbot-docs".
  "name": "statsbot-docs",
  "compatibility_date": "2025-09-01",
  "assets": { "directory": "./docs" }
}
